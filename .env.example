# FastAPI Configuration
FASTAPI_ENV=development
DEBUG=True
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DB=vehicle_rental_saas
MONGODB_USER=admin
MONGODB_PASSWORD=password123
MONGODB_URI=mongodb://admin:password123@mongodb:27017/vehicle_rental_saas?authSource=admin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@vehiclerental-saas.com
SMTP_FROM_NAME=Vehicle Rental SaaS

# Stripe Configuration (Optional)
STRIPE_API_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_secret

# Midtrans Configuration (Optional)
MIDTRANS_SERVER_KEY=your_server_key_here
MIDTRANS_CLIENT_KEY=your_client_key_here
MIDTRANS_IS_PRODUCTION=False

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=vehicle-rental-saas-bucket
AWS_REGION=us-east-1

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
